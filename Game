                        feedback: "Tijdelijke oplossing, foutgevoelig.",
                        impact: { budget: -5, sat: 0, data: 5 },
                        explanation: "Kost manuren (-5%). Data is er wel (+5%), maar met vertraging en typfouten.",
                        type: "mixed"
                    },
                    {
                        text: "Eis een API-koppeling (Contractmanagement).",
                        feedback: "Streng maar rechtvaardig.",
                        impact: { budget: 0, sat: -5, data: 20 },
                        explanation: "Leverancier moppert (-5% tevredenheid), maar je data is nu foutloos en real-time (+20%).",
                        type: "good"
                    }
                ]
            }
        ];

        const game = {
            state: {
                step: 0,
                stats: { budget: 100, sat: 50, data: 10 },
                eventQueue: [],
                isEventActive: false
            },
            
            init: function() {
                this.state.eventQueue = [...randomEvents].sort(() => 0.5 - Math.random());
            },

            start: function() {
                this.init();
                document.getElementById('start-screen').classList.remove('active');
                document.getElementById('game-screen').classList.add('active');
                document.getElementById('stats-bar').style.display = 'flex';
                this.updateUI();
                this.loadScenario();
            },

            loadScenario: function() {
                const gameCard = document.getElementById('game-screen');
                const badge = document.getElementById('scenario-badge');
                
                let currentItem;
                
                if (!this.state.isEventActive && (this.state.step === 1 || this.state.step === 3) && Math.random() > 0.3) {
                     this.state.isEventActive = true;
                     currentItem = this.state.eventQueue.pop(); 
                     
                     gameCard.classList.add('event-mode');
                     badge.innerText = "ONVERWACHT";
                } else {
                    this.state.isEventActive = false;
                    currentItem = mainScenarios[this.state.step];
                    
                    gameCard.classList.remove('event-mode');
                    badge.innerText = currentItem.module.split(':')[0];
                }

                if (!currentItem) {
                    if (this.state.step >= mainScenarios.length) {
                        this.endGame();
                        return;
                    }
                    currentItem = mainScenarios[this.state.step];
                }

                document.getElementById('scenario-title').innerText = currentItem.title;
                document.getElementById('scenario-context').innerText = currentItem.context;
                document.getElementById('scenario-text').innerText = currentItem.text;
                
                if (!this.state.isEventActive) {
                    const percentage = ((this.state.step) / mainScenarios.length) * 100;
                    document.getElementById('progress-fill').style.width = percentage + '%';
                }

                const container = document.getElementById('choices-container');
                container.innerHTML = '';
                
                currentItem.options.forEach((opt, index) => {
                    const btn = document.createElement('button');
                    btn.className = 'choice-btn';
                    btn.innerHTML = `<strong>${String.fromCharCode(65 + index)}.</strong> &nbsp; ${opt.text}`;
                    btn.onclick = () => this.makeChoice(opt);
                    container.appendChild(btn);
                });
                
                setTimeout(() => {
                    const firstBtn = container.querySelector('button');
                    if(firstBtn) firstBtn.focus();
                }, 100);
            },

            makeChoice: function(option) {
                this.state.stats.budget = Math.max(0, Math.min(100, this.state.stats.budget + option.impact.budget));
                this.state.stats.sat = Math.max(0, Math.min(100, this.state.stats.sat + option.impact.sat));
                this.state.stats.data = Math.max(0, Math.min(100, this.state.stats.data + option.impact.data));
                
                this.updateUI();
                this.showFeedback(option);
            },

            showFeedback: function(option) {
                const overlay = document.getElementById('feedback-overlay');
                const title = document.getElementById('fb-title');
                const text = document.getElementById('fb-text');
                const reason = document.getElementById('expl-reason');
                const nextBtn = document.getElementById('fb-next-btn');

                if (this.state.isEventActive) {
                    title.innerText = "Consequentie";
                    title.className = "feedback-title event";
                } else {
                    title.innerText = option.type === 'good' ? "Sterke Keuze!" : (option.type === 'bad' ? "Oei, risicovol..." : "Keuze Gemaakt");
                    title.className = `feedback-title ${option.type}`;
                }
                
                text.innerText = option.feedback;
                reason.innerText = option.explanation || "Geen extra toelichting.";
                
                // Helper func voor kleur van cijfers
                const setExpl = (id, val) => {
                    const el = document.getElementById(id);
                    if(val > 0) { el.innerText = `+${val}%`; el.className = "impact-delta delta-pos"; }
                    else if(val < 0) { el.innerText = `${val}%`; el.className = "impact-delta delta-neg"; }
                    else { el.innerText = "0%"; el.className = "impact-delta delta-neutral"; }
                };

                setExpl('expl-budget', option.impact.budget);
                setExpl('expl-sat', option.impact.sat);
                setExpl('expl-data', option.impact.data);

                overlay.classList.add('active');
                nextBtn.focus();

                nextBtn.onclick = () => {
                    overlay.classList.remove('active');
                    
                    if (this.state.isEventActive) {
                        this.state.isEventActive = false; 
                    } else {
                        this.state.step++;
                    }

                    if (this.state.step < mainScenarios.length) {
                        this.loadScenario();
                    } else {
                        this.endGame();
                    }
                };
            },

            updateUI: function() {
                const updateStat = (id, val) => {
                    const el = document.getElementById(id);
                    el.innerText = val;
                    el.className = 'stat-value ' + (val < 30 ? 'stat-low' : (val > 80 ? 'stat-high' : ''));
                };

                updateStat('stat-budget', this.state.stats.budget);
                updateStat('stat-sat', this.state.stats.sat);
                updateStat('stat-data', this.state.stats.data);
            },

            endGame: function() {
                document.getElementById('game-screen').classList.remove('active');
                document.getElementById('end-screen').classList.add('active');

                document.getElementById('end-budget').innerText = this.state.stats.budget;
                document.getElementById('end-sat').innerText = this.state.stats.sat;
                document.getElementById('end-data').innerText = this.state.stats.data;

                const total = this.state.stats.budget + this.state.stats.sat + this.state.stats.data;
                let msg = "";
                let tips = [];

                if (total > 230) {
                    msg = "🏆 Uitstekend! Je hebt Nexus Plaza succesvol getransformeerd. Je hebt strategisch inzicht getoond.";
                } else if (total > 180) {
                    msg = "👍 Goed gedaan. De basis staat, maar let op de balans tussen kosten en kwaliteit.";
                } else {
                    msg = "⚠️ De transformatie is moeizaam verlopen. Probeer meer balans te vinden in de volgende poging.";
                }

                if (this.state.stats.budget < 40) tips.push("Tip: Let op je Budget. Innovatie moet wel betaalbaar blijven.");
                if (this.state.stats.sat < 40) tips.push("Tip: Vergeet de Eindgebruiker niet. Data is een middel, geen doel.");
                if (this.state.stats.data < 40) tips.push("Tip: Je Data Maturiteit is laag. Zonder betrouwbare data stuur je blind.");

                document.getElementById('final-message').innerText = msg;
                document.getElementById('learning-points').innerHTML = tips.map(t => `<p style="margin-bottom:0.5rem;">${t}</p>`).join("");
            }
        };

    </script>
</body>
</html>
